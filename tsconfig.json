{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "dsh-shellout-protocol": [
        "./packages/protocol/src/index.ts"
      ],
      "dsh-shellout-runner/core": [
        "./packages/runner/src/core/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "vitest.config.ts"
  ]
}
